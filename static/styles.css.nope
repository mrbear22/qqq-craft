        /* == ФОНТИ == */
        @font-face {
            font-family: 'Minecraft';
            src: url('/static/Minecraft_1.1.ttf') format('truetype');
        }

        /* == ГЛОБАЛЬНІ СТИЛІ == */
        * {
            font-family: 'Minecraft', sans-serif;
            outline: none;
            box-sizing: border-box;
        }

        body {
            margin: 0;
            overflow: hidden;
        }

        /* == КОНТЕЙНЕР == */
        .container {
            display: flex;
            height: 100vh;
            position: relative;
        }

        /* == СТИЛІ ДЛЯ ВІКНА НОВИН == */
        .news {
            flex: 1;
            padding: 30px;
            background-image: url('/static/background.png');
            background-color: #9e644c;
            background-attachment: fixed;
            background-size: cover;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            overflow-y: auto;
            position: relative;
        }

        .news::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(139, 69, 19, 0.1) 0%, rgba(75, 46, 42, 0.2) 100%);
            pointer-events: none;
        }

        #news-list {
            max-width: 900px;
            width: 100%;
            position: relative;
            z-index: 1;
        }

        .news h1 {
            color: #f8f0e3;
            text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.8);
            text-align: center;
            font-size: 2.5em;
            margin-bottom: 30px;
            letter-spacing: 2px;
        }

        /* == ПАНЕЛЬ ВХОДУ == */
        .login-panel {
            width: 420px;
            padding: 30px;
            background: linear-gradient(135deg, #fdfbdf 0%, #f4e4ba 50%, #e8d5a6 100%);
            border-left: 5px solid #9e644c;
            height: 100vh;
            text-align: center;
            user-select: none;
            overflow-y: auto;
            position: relative;
            box-shadow: -10px 0 30px rgba(0, 0, 0, 0.2);
        }

        .login-panel::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(90deg, #8b4513, #d2691e, #8b4513);
        }

        .logo-section {
            margin-bottom: 30px;
            position: relative;
        }

        .logo-section img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 4px solid #8b4513;
            box-shadow: 0 8px 20px rgba(139, 69, 19, 0.3);
            transition: transform 0.3s ease;
        }

        .logo-section img:hover {
            transform: scale(1.05) rotate(2deg);
        }

        .login-panel h1 {
            color: #4b2e2a;
            letter-spacing: 3px;
            margin: 20px 0;
            font-size: 1.8em;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.1);
        }

        /* == ФОРМА == */
        .login-form {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .input-group {
            text-align: left;
        }

        .input-group label {
            display: block;
            font-size: 14px;
            color: #4b2e2a;
            margin-bottom: 8px;
            font-weight: bold;
        }

        .input {
            width: 100%;
            font-size: 16px;
            padding: 12px 16px;
            border: 3px solid #a57c55;
            border-radius: 12px;
            background: #f8f0e3;
            color: #493728;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .input:focus {
            border-color: #d2691e;
            box-shadow: 0 0 0 3px rgba(210, 105, 30, 0.2);
            transform: translateY(-2px);
        }

        .input:hover {
            border-color: #d2691e;
        }

        /* == НАЛАШТУВАННЯ == */
        .settings-section {
            margin: 20px 0;
        }

        details {
            background: #f8f0e3;
            border-radius: 12px;
            border: 3px solid #a57c55;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        details[open] {
            box-shadow: 0 5px 15px rgba(139, 69, 19, 0.2);
        }

        summary {
            padding: 15px 20px;
            cursor: pointer;
            color: #4b2e2a;
            font-weight: bold;
            background: linear-gradient(135deg, #f8f0e3, #f0e1c0);
            transition: all 0.3s ease;
            border-bottom: 2px solid transparent;
        }

        summary:hover {
            background: linear-gradient(135deg, #f0e1c0, #e8d5a6);
            color: #8b4513;
        }

        details[open] summary {
            border-bottom-color: #a57c55;
            color: #8b4513;
        }

        .settings-content {
            padding: 20px;
            display: grid;
            gap: 15px;
        }

        .setting-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .setting-row label {
            margin: 0;
            flex: 1;
        }

        .setting-row .input {
            width: auto;
            min-width: 120px;
        }

        .checkbox-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0;
        }

        .checkbox-row input[type="checkbox"] {
            width: 20px;
            height: 20px;
            accent-color: #8b4513;
        }

        .folder-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #8b4513;
            text-decoration: none;
            padding: 8px 12px;
            border-radius: 8px;
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

        .folder-link:hover {
            background: rgba(139, 69, 19, 0.1);
            border-color: #8b4513;
        }

        /* == ЛОГИ == */
        .log-section {
            margin: 20px 0;
        }

        #log-box {
            background: #2c2c2c;
            border-radius: 12px;
            border: 3px solid #555;
            min-height: 80px;
            max-height: 150px;
            overflow-y: auto;
            padding: 15px;
            font-family: 'Courier New', monospace;
            color: #00ff00;
            font-size: 12px;
            line-height: 1.4;
            position: relative;
        }

        #log-box:empty::before {
            content: 'Готовий до запуску...';
            color: #888;
            font-style: italic;
        }

        #logs {
            word-wrap: break-word;
        }

        #logs > div {
            margin-bottom: 5px;
            padding: 2px 0;
        }

        .loading-dots::after {
            content: '';
            display: inline-block;
            width: 1em;
            animation: dots 1s steps(3, end) infinite;
            color: #ffd700;
        }

        @keyframes dots {
            0% { content: ''; }
            33% { content: '.'; }
            66% { content: '..'; }
            100% { content: '...'; }
        }

        /* == КНОПКА ЗАПУСКУ == */
        .launch-section {
            margin: 25px 0;
        }

        #start {
            width: 100%;
            background: linear-gradient(135deg, #8b4513 0%, #a0522d 50%, #8b4513 100%);
            color: #f0e6d6;
            font-size: 18px;
            padding: 15px 25px;
            border: 3px solid #4b2d0b;
            border-radius: 15px;
            text-transform: uppercase;
            letter-spacing: 2px;
            box-shadow: 0 6px 0 #4b2d0b, 0 8px 20px rgba(75, 45, 11, 0.3);
            transition: all 0.3s ease;
            cursor: pointer;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
            font-family: inherit;
            font-weight: bold;
            position: relative;
            overflow: hidden;
        }

        #start::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s ease;
        }

        #start:hover::before {
            left: 100%;
        }

        #start:hover {
            background: linear-gradient(135deg, #a0522d 0%, #cd853f 50%, #a0522d 100%);
            transform: translateY(-3px);
            box-shadow: 0 9px 0 #4b2d0b, 0 12px 25px rgba(75, 45, 11, 0.4);
        }

        #start:active {
            transform: translateY(2px);
            box-shadow: 0 2px 0 #4b2d0b, 0 4px 10px rgba(75, 45, 11, 0.3);
        }

        #start:disabled {
            background: #888;
            border-color: #555;
            box-shadow: 0 3px 0 #555;
            cursor: not-allowed;
            transform: none;
        }

        #start:disabled::before {
            display: none;
        }

        /* == ОНОВЛЕННЯ == */
        #update {
            margin-top: 15px;
            padding: 12px;
            background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
            border: 2px solid #d63031;
            border-radius: 10px;
            color: white;
            font-size: 14px;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
            animation: pulse 2s infinite;
        }

        #update a {
            color: #fff;
            font-weight: bold;
        }

        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(214, 48, 49, 0.4); }
            70% { box-shadow: 0 0 0 10px rgba(214, 48, 49, 0); }
            100% { box-shadow: 0 0 0 0 rgba(214, 48, 49, 0); }
        }

        /* == НОВИНИ == */
        .new {
            display: flex;
            border-radius: 15px;
            margin-bottom: 25px;
            padding: 25px;
            background: linear-gradient(135deg, rgba(253, 251, 223, 0.95) 0%, rgba(244, 228, 186, 0.95) 100%);
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
            border: 2px solid rgba(158, 100, 76, 0.3);
            transition: all 0.3s ease;
        }

        .new:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.2);
        }

        .news-image {
            flex: 0 0 250px;
            max-height: 200px;
            overflow: hidden;
            border-radius: 12px;
            margin-right: 25px;
            border: 3px solid #a57c55;
        }

        .news-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .news-image img:hover {
            transform: scale(1.1);
        }

        .news-content {
            flex: 1;
        }

        .news-title {
            font-size: 1.6em;
            color: #4b2e2a;
            margin-bottom: 10px;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);
        }

        .news-description {
            font-size: 1em;
            color: #4b2e2a;
            line-height: 1.6;
            margin-bottom: 15px;
        }

        .news-timestamp {
            font-size: 0.8em;
            color: #8b4513;
            text-align: right;
            margin-bottom: 10px;
            font-style: italic;
        }

        .reactions {
            display: flex;
            gap: 10px;
            margin: 15px 0;
            flex-wrap: wrap;
        }

        .reaction-button {
            background: linear-gradient(135deg, #f4e4ba, #e8d5a6);
            border: 2px solid #a57c55;
            border-radius: 20px;
            padding: 6px 12px;
            font-size: 0.9em;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .reaction-button:hover {
            background: linear-gradient(135deg, #e8d5a6, #d3c2a4);
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(139, 69, 19, 0.2);
        }

        .comments {
            margin-top: 20px;
            padding-top: 15px;
            border-top: 2px dashed #a57c55;
        }

        .comments h4 {
            color: #4b2e2a;
            margin-bottom: 10px;
        }

        .comment {
            margin-bottom: 12px;
            padding: 8px 12px;
            background: rgba(248, 240, 227, 0.6);
            border-radius: 8px;
            border-left: 4px solid #8b4513;
            font-size: 0.9em;
        }

        /* == СКРОЛ == */
        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(135deg, #a57c55, #8b4513);
            border-radius: 10px;
            border: 2px solid #f8f0e3;
        }

        ::-webkit-scrollbar-track {
            background: #f0e1c0;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(135deg, #8b4513, #654321);
        }

        /* == АДАПТИВНІСТЬ == */
        @media (max-width: 1200px) {
            .container {
                flex-direction: column;
                height: auto;
            }
            
            .news {
                height: 60vh;
            }
            
            .login-panel {
                width: 100%;
                height: auto;
            }
        }

        @media (max-width: 768px) {
            .new {
                flex-direction: column;
            }
            
            .news-image {
                flex: none;
                margin-right: 0;
                margin-bottom: 15px;
            }
        }

        img {
            pointer-events: none;
        }